{
  "name": "@eu-ge-ne/toy",
  "version": "0.0.33-rc",
  "license": "MIT",
  "exports": "./src/main.ts",
  "workspace": [
    "src/plugins/*",
    "src/libs/*"
  ],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended",
        "workspace"
      ],
      "include": [
        "eqeqeq",
        "explicit-function-return-type"
      ],
      "exclude": [
        "require-await"
      ]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/fmt": "jsr:@std/fmt@^1.0.10"
  }
}
